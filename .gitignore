# Rust build output. (Cargo.lock is committed on purpose: this crate ships a
# binary, and CI / `make` build with --locked.)
/target

# Playground scratch stores and Python bytecode from serve.py
/playground/ui-data/
/playground/play-data/
/playground/__pycache__/

# OS, editor, secrets
.DS_Store
.env
.env.local

# Per-user Claude Code overrides (settings.json is shared, .local is not)
.claude/settings.local.json

# This repo's own HippoTask ledger: agent task state stays local by default.
# To share tasks through git instead, see .hippotask/README.md.
.hippotask/*
!.hippotask/README.md
