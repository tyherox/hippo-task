{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "schema:generate": {
      "dependsOn": ["build"],
      "outputs": ["schema/**"]
    },
    "scorecard:generate": {
      "cache": false,
      "outputs": []
    },
    "scorecard:validate": {
      "cache": false,
      "outputs": []
    },
    "scorecard:check-links": {
      "cache": false,
      "outputs": []
    }
  }
}
