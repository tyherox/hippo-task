{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hippotask.dev/schema/1.0.0/hippo-task.schema.json",
  "title": "HippoTask (schema 1.0.0)",
  "x-hippotask-schema-version": "1.0.0",
  "$ref": "#/definitions/HippoTask",
  "definitions": {
    "HippoTask": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "external_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "description_format": {
          "type": "string",
          "enum": [
            "markdown",
            "plaintext",
            "html"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "backlog",
            "todo",
            "in_progress",
            "in_review",
            "done",
            "cancelled"
          ]
        },
        "status_raw": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "urgent"
          ]
        },
        "priority_raw": {
          "type": [
            "string",
            "number"
          ]
        },
        "assignees": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "external_ids": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "creator": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "external_ids": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        },
        "due_date": {
          "type": "string"
        },
        "start_date": {
          "type": "string"
        },
        "completed_at": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "parent_id": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "estimate_unit": {
          "type": "string",
          "enum": [
            "points",
            "hours",
            "minutes"
          ]
        },
        "custom_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "date",
                  "select",
                  "multi_select",
                  "url",
                  "email",
                  "person"
                ]
              },
              "value": {},
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "label",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {}
        },
        "schema_version": {
          "type": "string",
          "enum": [
            "1.0.0"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "created_at",
        "updated_at",
        "schema_version"
      ],
      "additionalProperties": false
    }
  }
}
