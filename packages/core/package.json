{
  "name": "@hippotask/core",
  "version": "0.1.0",
  "description": "Universal task schema, validation, and utilities for HippoTask",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "schema", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "scorecard:generate": "tsx scripts/scorecard/generate.ts",
    "scorecard:validate": "tsx scripts/scorecard/validate.ts",
    "scorecard:check-links": "tsx scripts/scorecard/check-links.ts"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0",
    "tsup": "^8.4.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
