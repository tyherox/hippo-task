{
  "name": "hippo-task",
  "private": true,
  "description": "Hippocampus for modern work — an open schema and toolkit for task interoperability",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "turbo run clean",
    "schema:generate": "turbo run schema:generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^25.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
